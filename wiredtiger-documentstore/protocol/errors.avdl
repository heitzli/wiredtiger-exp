schema document.errors.Error;

@namespace("document.errors")
error Error {
  string error;
  string component = "";
  string kind = "GenericError";
}

@namespace("document.errors")
error QueryProcessorError {
  string error;
  string component = "";
  string kind = "QueryProcessorError";
}

@namespace("document.errors")
error DocumentQLSyntaxError {
  string error;
  string component = "";
  string kind = "DocumentQLSyntaxError";
}

@namespace("document.errors")
error WiredTigerError {
  string error;
  string component = "";
  string kind = "WiredTigerError";
}
