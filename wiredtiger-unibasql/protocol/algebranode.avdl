schema unibasql.queryprocessor.algebra.AlgebraNode;

@namespace("unibasql.queryprocessor.algebra")
record AlgebraNode {
  string kind;
  ResolvedTable? table = null;
  union{null, array<array<ResolvedValue>>} values = null;
  union{null, array<ResolvedColumn>} columns = null;
  Expr? expr = null;
  AlgebraNode? left = null;
  AlgebraNode? right = null;
  AlgebraNode? child = null;
  union{null, array<Assignment>} assignments = null;
  union {null, map<string>} custom = null;
}

@namespace("unibasql.queryprocessor.algebra")
enum DataType {
  STRING,
  BOOL,
  INT,
  DOUBLE
}

@namespace("unibasql.queryprocessor.algebra")
enum ColumnConstraint {
  NOT_NULL,
  PRIMARY_KEY
}

@namespace("unibasql.queryprocessor.algebra")
record ResolvedTable {
  string kind = "ResolvedTable";
  string name;
  array<ResolvedColumn> tableSchema;
  string? alias = null;
  union {null, map<string>} custom = null;
}

@namespace("unibasql.queryprocessor.algebra")
record ResolvedColumn {
  string kind = "ResolvedColumn";
  string name;
  DataType type;
  ColumnConstraint? constraint = null;
  string? qualifier = null;
  union {null, map<string>} custom = null;
}

@namespace("unibasql.queryprocessor.algebra")
record ResolvedValue {
  string kind = "ResolvedValue";
  DataType type;
  union {int, long, float, double, string, boolean, null} value;
  union {null, map<string>} custom = null;
}

@namespace("unibasql.queryprocessor.algebra")
record Assignment {
    ResolvedColumn column;
    Expr expr;
}

@namespace("unibasql.queryprocessor.algebra")
record Expr {
  union {LiteralExpr, BinOp, UnOp, TableRef, ColumnRef} expr;
}

@namespace("unibasql.queryprocessor.algebra")
record TableRef {
  string kind = "TableRef";
  string name;
  string? alias = null;
  union {null, map<string>} custom = null;
}

@namespace("unibasql.queryprocessor.algebra")
record ColumnRef {
  string kind = "ColumnRef";
  string name;
  string? qualifier = null;
  union {null, map<string>} custom = null;
}

@namespace("unibasql.queryprocessor.algebra")
record LiteralExpr {
  string kind = "LiteralExpr";
  string type;
  // Order matters. avro-python (1.12.2, AVRO-973) picks the LAST branch whose
  // validate() passes, and int validates for long/float/double as well, so with
  // narrow->wide order every numeric datum is written as double: the SM
  // receives 27.0 while the `type` tag stays "int" and stores b"27.0".
  // Lossless for |value| <= 2^53 (Python float -> double is always lossless);
  // only ints beyond 2^53 lose precision on the wire.
  // Do NOT "fix" this by reordering wide->narrow: that makes ints exact but
  // pushes floats into the float32 branch (1.79 -> 1.7899999618530273).
  // If exact int round-trips are ever needed, normalize on decode instead:
  // from_avro_expr: if type == "int": value = int(value).
  union {int, long, float, double, string, boolean, null} value;
  union {null, map<string>} custom = null;
}


@namespace("unibasql.queryprocessor.algebra")
record BinOp {
  string kind = "BinOp";
  string op;
  Expr left;
  Expr right;
  union {null, map<string>} custom = null;
}

@namespace("unibasql.queryprocessor.algebra")
record UnOp {
  string kind = "UnOp";
  string op;
  Expr expr;
  union {null, map<string>} custom = null;
}
