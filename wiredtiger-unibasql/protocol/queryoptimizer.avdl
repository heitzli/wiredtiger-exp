// Note for the moment algebra pass through

@namespace("unibasql.queryoptimizer")
protocol StorageManager {
  import idl "algebranode.avdl";
  import idl "errors.avdl";

  record OptimizeRequest {
    unibasql.queryprocessor.algebra.AlgebraNode plan;
    union {null, map<string>} custom = null;
  }

  record OptimizeResponse {
    unibasql.queryprocessor.algebra.AlgebraNode plan;
    union {null, map<string>} custom = null;
  }


  OptimizeResponse optimize(OptimizeRequest request) throws unibasql.errors.WiredTigerError;
}
