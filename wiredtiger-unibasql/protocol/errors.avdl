schema unibasql.errors.Error;

@namespace("unibasql.errors")
error Error {
  string error;
  string component = "";
  string kind = "GenericError";
}

@namespace("unibasql.errors")
error QueryProcessorError {
  string error;
  string component = "";
  string kind = "QueryProcessorError";
}

@namespace("unibasql.errors")
error UnibaSQLSyntaxError {
  string error;
  string component = "";
  string kind = "UnibaSQLSyntaxError";
}

@namespace("unibasql.errors")
error WiredTigerError {
  string error;
  string component = "";
  string kind = "WiredTigerError";
}
