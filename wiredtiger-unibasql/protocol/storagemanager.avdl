@namespace("unibasql.storagemanager")
protocol StorageManager {
  import idl "algebranode.avdl";
  import idl "errors.avdl";
  import idl "ddlnode.avdl";
  import idl "tclnode.avdl";

  record ExecuteQueryRequest {
    unibasql.queryprocessor.algebra.AlgebraNode plan;
    union {null, map<string>} custom = null;
  }

  record WTValue {
    string type;
    string value;
  }

  record ExecuteQueryResponse {
    map<string> value;
    union {null, map<map<WTValue>>} documents = null;
    union {null, map<string>} custom = null;
  }

  record ExecuteDDLRequest {
    unibasql.queryprocessor.ddl.DDLNode plan;
    union {null, map<string>} custom = null;
  }

  record ExecuteDDLResponse {
    map<string> value;
    union {null, map<string>} custom = null;
  }

  record ExecuteTCLRequest {
    unibasql.queryprocessor.tcl.TCLNode plan;
    union {null, map<string>} custom = null;
  }

  record ExecuteTCLResponse {
    map<string> value;
    union {null, map<string>} custom = null;
  }

  ExecuteQueryResponse execute(ExecuteQueryRequest request) throws unibasql.errors.WiredTigerError;
  ExecuteDDLResponse execute_ddl(ExecuteDDLRequest request) throws unibasql.errors.WiredTigerError;
  ExecuteTCLResponse execute_tcl(ExecuteTCLRequest request) throws unibasql.errors.WiredTigerError;
}
