@namespace("unibasql.queryprocessor")
protocol Queryprocessor{

  import idl "errors.avdl";

  record EvaluateQueryRequest {
    string query;
    union {null, map<string>} custom = null;
  }

  record WTValue {
    string type;
    bytes value;
  }

  record EvaluateQueryResponse {
    map<WTValue> value;
    union {null, map<map<WTValue>>} documents = null;
    union {null, map<string>} custom = null;
  }

  EvaluateQueryResponse evaluate(EvaluateQueryRequest request) throws unibasql.errors.QueryProcessorError, unibasql.errors.UnibaSQLSyntaxError, unibasql.errors.WiredTigerError;

}
