schema unibasql.queryprocessor.ddl.DDLNode;

import idl "algebranode.avdl";

@namespace("unibasql.queryprocessor.ddl")
enum DDLOp {
  CREATE,
  DROP
}

@namespace("unibasql.queryprocessor.ddl")
record DDLNode {
  string kind;
  unibasql.queryprocessor.algebra.ResolvedTable? table = null;
  DDLOp? op = null;
  string? idx_name = null;
  union{null, array<unibasql.queryprocessor.algebra.ResolvedColumn>} columns = null;
  union {null, map<string>} custom = null;
}
